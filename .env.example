# Azure Speech Service
AZURE_SPEECH_KEY=your_azure_speech_key_here   #
AZURE_SPEECH_REGION=japaneast

# TTS Settings
TTS_VOICE=ja-JP-KeitaNeural
# Base speed and absolute catch-up ceiling, both 0.5 to 2.0.
# Long sentences speed up to the ceiling; remaining overflow may overlap.
TTS_SPEED=1.0
TTS_OVERFLOW_MAX_SPEED=1.4

# Subtitle appearance (12 bundled families; size in video pixels, 12-160).
SUBTITLE_FONT=Phudu
SUBTITLE_FONT_SIZE=56
SUBTITLE_TEXT_COLOR=#FFFFFF
SUBTITLE_OUTLINE_COLOR=#000000
SUBTITLE_BG_COLOR=#0C100C
SUBTITLE_BG_OPACITY=84
SUBTITLE_BG_ENABLED=1

# Vietnamese TTS (LucyLab API)
VIETNAMESE_API_KEY=your_lucylab_api_key_here  #
# Optional fallback keys. LucyLab automatically tries the next key when the
# previous one is out of credits, rate-limited, unauthorized, or invalid.
VIETNAMESE_API_KEY_2=
VIETNAMESE_API_KEY_3=
VIETNAMESE_API_KEY_4=
VIETNAMESE_API_KEY_5=
VIETNAMESE_VOICEID_MALE=your_male_voice_id_here  #
VIETNAMESE_VOICEID_FEMALE=your_female_voice_id_here   #
VOICE_TYPE=male
LUCYLAB_API_URL=https://api.lucylab.io/json-rpc
# Optional fallback voice when LucyLab is unavailable or out of credits
AZURE_VI_TTS_VOICE=vi-VN-HoaiMyNeural
# Azure fallback: bounded retries for temporary errors and shorter requests.
AZURE_VI_TTS_MAX_ATTEMPTS=3
AZURE_VI_TTS_RETRY_DELAY=2
AZURE_VI_TTS_FRAME_TIMEOUT_MS=10000
AZURE_VI_TTS_RTF_TIMEOUT_THRESHOLD=10
AZURE_VI_TTS_CHUNK_CHARS=240

# Video Input
VIDEO_URL=https://youtube.com/watch?v=xxx

# General
# SQLite is created automatically; relative paths are anchored to the project.
# API keys stay in .env. Existing non-secret settings are imported once.
# STUDIO_DB_PATH=./data/studio.sqlite3
# Use Settings > Voice library to save/select custom voice:<id> references.
# DEFAULT_VOICE_VI=male
# DEFAULT_VOICE_JP=ja-JP-KeitaNeural
DEFAULT_SOURCE_LANG=en-US
AUDIO_SAMPLE_RATE=16000
OUTPUT_DIR=./output
GOOGLE_API_KEY=your_gemini_google_api_key_here   #

# Video quality when AI blur or burned-in subtitles require re-encoding.
# VIDEO_CRF=0 is lossless. Use 16-18 for a much smaller, visually lossless file.
VIDEO_CRF=0
# Preset changes speed/file size, not image quality.
VIDEO_PRESET=medium
